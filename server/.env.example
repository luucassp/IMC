# Dev: SQLite local. Para produção, troque por uma URL Postgres:
#   DATABASE_URL="postgresql://user:senha@host:5432/imc?schema=public"
# e ajuste provider em prisma/schema.prisma para "postgresql".
DATABASE_URL="file:./dev.db"

# Troque por um segredo forte em produção.
JWT_SECRET="troque-este-segredo-em-producao"

PORT=3333
