# PostgreSQL. Em dev você pode usar um Postgres local (Docker) ou um banco
# gerenciado free (Supabase/Neon). Em produção, use a connection string do
# provedor. Formato:
#   postgresql://USUARIO:SENHA@HOST:5432/BANCO?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/imc?schema=public"

# Troque por um segredo forte em produção.
JWT_SECRET="troque-este-segredo-em-producao"

PORT=3333

# Origens permitidas no CORS (separe por vírgula). Em produção, a URL do
# front no Netlify. Vazio = libera qualquer origem (use só em dev).
CORS_ORIGIN=""

# Login com Google (opcional). Crie um OAuth Client ID em
# https://console.cloud.google.com/apis/credentials e use o MESMO id no
# front (VITE_GOOGLE_CLIENT_ID). Sem isso, /auth/google responde 503.
GOOGLE_CLIENT_ID=""
